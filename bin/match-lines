#!/bin/bash

# print lines in file_a which are also present in file_b
# -v reverses the match
#
# set -x
# usage
# match-lines file_a file_b
# match-lines -v file_a file_b

# Check for the -v flag
print_present=true
if [[ "$1" == "-v" ]]; then
    print_present=false
    shift # Remove the flag from the argument list
fi

# Assign the files to variables
file_a="$1"
file_b="$2"

if [[ "$print_present" == true ]]; then
    grep -iFf $file_a $file_b
else
    grep -ivFf $file_a $file_b
fi
