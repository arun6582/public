#!/usr/bin/env bash

file=test

gcc -v

cleanup() {
	rm -rf $file
}

cleanup_signal() {
	echo "Ctrl+C pressed"
	cleanup
	exit 0
}

trap cleanup INT

curl -fsSL \
	'https://raw.githubusercontent.com/arun6582/public/master/cpu-benchmark/factorial.c' |
	gcc -O0 -std=c11 -pthread -x c -o $file -
./$file 1500 100

cleanup
