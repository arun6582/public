#!/usr/bin/env python
import sys
import time
from functools import wraps


def timer(func):
    @wraps(func)
    def wrapper(*args, **kwargs):
        start = time.perf_counter()
        result = func(*args, **kwargs)
        elapsed = time.perf_counter() - start
        score = 100.0 / elapsed
        print(f"{score:.2f}")
        return result

    return wrapper


def factorial(n):
    if n == 1:
        return 1
    return n * factorial(n - 1)


@timer
def reps(x, f, *args, **kw):
    for x in range(0, x):
        f(*args, **kw)


if __name__ == "__main__":
    reps(int(sys.argv[2]), factorial, int(sys.argv[1]))
